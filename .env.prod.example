# Example production environment file for NoctisAPI
# Copy to .env.prod and fill in real values. Do NOT commit secrets.

# -----------------------------------------------------------------------------
# General settings
APP_ENV=prod
HP_IMAGE=ghcr.io/0x-unkwn0wn/noctisapi-pro   # optional override of the image registry/name
APP_VERSION=latest   # semver or image tag matching the published Docker image
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (SQLite) - path inside container
HP_DB_PATH=/data/honeypot.db
DATABASE_URL=sqlite+pysqlite:////data/honeypot.db

# GeoIP database
HP_GEOIP_DB=/app/data/GeoLite2-Country.mmdb

# Public URLs (used in various admin views / downloads)
HP_PUBLIC_BASE_URL=https://your-api.example.com
HONEYPOT_PUBLIC_BASE_URL=https://your-api.example.com   # for panel links
HONEYPOT_MONITOR_BASE_URL=http://traefik:8081            # internal address

# Traefik / TLS configuration
HP_PUBLIC_HOST=your-api.example.com
HP_ADMIN_HOST=admin.example.com
ACME_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# Licensing / PRO
LICENSE_KEY=sk_live_...
PRO_BACKEND_URL=https://pro-backend.example.com
LICENSING_URL=https://license.unkwn0wn.com        # secondary URL used in some client tooling
LICENSING_PINNED_PUBLIC_KEY_PATH=/app/app/licensing_server_public_key.pem
INSTANCE_ID_PATH=/var/lib/myapp/instance_id
HP_PRO_LEASE_CACHE_PATH=/var/lib/myapp/pro_lease_cache.json
HP_LICENSE_REPORT_TO_SERVER=0                     # 1 to post license telemetry back to backend
HP_LICENSE_REPORT_URL=https://license.unkwn0wn.com
# Optional: stable host fingerprint
#INSTANCE_FINGERPRINT_SHA256=...
#HP_HOST_MACHINE_ID_PATH=/etc/host-machine-id
# Enforcement behaviour
#HP_ENFORCE_LICENSE=1
#HP_LICENSE_DENY_BEHAVIOUR=exit   # choices: exit, warn, none
#HP_LICENSE_LIMITED_BEHAVIOUR=pro # behaviour when license tier insufficient
# HTTP settings
#LICENSING_HTTP_TIMEOUT_SECONDS=10
#LICENSING_MIN_RENEW_SECONDS=30
# Public key path for PRO results verification (optional)
#PRO_RESULTS_PUBLIC_KEY_PATH=/app/app/pro_results_public_key.pem

# -----------------------------------------------------------------------------
# Actor seed (required; keep secret and stable between restarts)
HP_SEED=<long-random-secret>
# Optional actor shaping
#HP_ACTOR_UA_MODE=family        # identity mode: ip, family, full

# Customize monitor clients allowed UA strings
#HONEYPOT_MONITOR_UA=HealthCheck/1.0,curl/

# -----------------------------------------------------------------------------
# Campaign configuration (defaults shown)
HP_CAMPAIGN_MIN_FEATURES=4
HP_CAMPAIGN_MIN_INTERSECTION=3
HP_CAMPAIGN_MIN_JACCARD=0.4
HP_CAMPAIGN_MAX_SESSIONS=5
HP_CAMPAIGN_PATH_NGRAM_TOP_K=12
HP_CAMPAIGN_PATH_TOP_K=10
HP_CAMPAIGN_ACTOR_LIMIT=200

# Automatic campaign recompute (set threshold >0 to enable)
HP_CAMPAIGN_AUTO_RECOMPUTE_THRESHOLD=0   # number of new actors before auto-trigger
HP_CAMPAIGN_AUTO_RECOMPUTE_INTERVAL=3600 # seconds between background checks

# -----------------------------------------------------------------------------
# Data retention / pruning
HP_RETENTION_EVENTS_DAYS=30
HP_RETENTION_SESSIONS_DAYS=30
HP_RETENTION_STEPS_DAYS=30
HP_RETENTION_CHECKS_DAYS=14
HP_RETENTION_TOKENS_DAYS=90
HP_RETENTION_JOBS_DAYS=30
HP_RETENTION_ENABLE=1

# -----------------------------------------------------------------------------
# Additional overrides can be added as needed (e.g. LOG_LEVEL etc.)
