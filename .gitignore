# Python
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/

# Environment files
.env
.env.*
# example files should be committed
!.env.prod.example
!.env.staging.example
!dist/.env.example

# Logs
*.log
logs/

# Data / DB
data/
*.db
*.sqlite
*.sqlite3

# Secrets / certs
compose/nginx/certs/
*.pem
!app/licensing_server_public_key.pem
!app/pro_results_public_key.pem
*.key
*.crt

# NOC-023: Managed deployment Docker secrets (real file content, never committed)
compose/secrets/*
!compose/secrets/README.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code agent memory
.claude/


# Internal probes (local only)
scripts/probe_actor_flow.py

# Build / cache
build/
# dist/ is intentionally tracked — customer-facing deploy files

# NOC-032: Terraform local state/cache and any tfvars file (likely to
# hold ssh_public_key or other per-customer values) — never committed.
# .terraform.lock.hcl IS committed deliberately (pins the exact provider
# build Terraform resolved, part of "plan reproducible").
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
