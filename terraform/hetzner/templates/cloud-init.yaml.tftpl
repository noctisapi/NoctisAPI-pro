#cloud-config
# NOC-033: rendered by terraform/hetzner/main.tf's templatefile(). Every
# $${...} / %%{ ... } below is a Terraform template construct, not a
# cloud-init feature -- see variables.tf for which inputs are sensitive
# and this module's README for the state-security caveat that implies.
# (Doubled $$/%% right above only because this IS a comment inside the
# template itself -- Terraform's template engine doesn't know YAML
# comments exist and would otherwise try to interpolate this sentence.)
#
# "Credenciales no aparecen en logs": cloud-init writes the full stdout
# of every runcmd command to /var/log/cloud-init-output.log, including
# the command LINE itself -- so secrets below are written via
# write_files (file content is not a logged command) and referenced
# in runcmd only by file PATH, never interpolated into a command string
# directly. The non-secret fields (customer_id/region/sizing/plan/
# hp_public_host/hp_admin_host) are fine to pass as plain env vars on
# the runcmd line -- see scripts/deployment_manifest.py's own
# sensitive-key-substring list (NOC-031), none of these match it.

package_update: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - ufw
  - git

users:
  - default
  - name: ${admin_ssh_user}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /root/.git-deploy-token
    permissions: '0600'
    owner: root:root
    content: ${git_deploy_token}

  - path: /root/.env.prod.staged
    permissions: '0600'
    owner: root:root
    content: |
      APP_ENV=prod
      HP_IMAGE=${hp_image}
      MANAGED_APP_VERSION=${app_version}
      DATABASE_URL=sqlite+pysqlite:////data/honeypot.db
      HP_PUBLIC_HOST=${hp_public_host}
      HP_ADMIN_HOST=${hp_admin_host}
      ACME_EMAIL=${acme_email}
      CLOUDFLARE_TUNNEL_TOKEN=${cloudflare_tunnel_token}
      HP_ENFORCE_LICENSE=1
      HP_DEPLOYMENT_ID=${deployment_id}
      LOG_LEVEL=info

  - path: /etc/ssh/sshd_config.d/99-noctisapi-hardening.conf
    permissions: '0644'
    owner: root:root
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
%{ if ghcr_token != "" }

  - path: /root/.ghcr-token
    permissions: '0600'
    owner: root:root
    content: ${ghcr_token}
%{ endif }

runcmd:
  - systemctl restart ssh
  - install -m 0755 -d /etc/apt/keyrings
  - [ bash, -c, "curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg" ]
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - [ bash, -c, "echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable\" > /etc/apt/sources.list.d/docker.list" ]
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
  - [ bash, -c, "git clone https://x-access-token:$(cat /root/.git-deploy-token)@${trimprefix(git_repo_url, "https://")} /opt/hp-app" ]
  - shred -u /root/.git-deploy-token
  - mv /root/.env.prod.staged /opt/hp-app/.env.prod
  - chmod 600 /opt/hp-app/.env.prod
  - [ bash, -c, "HP_CUSTOMER_ID='${customer_id}' HP_REGION='${region}' HP_SIZING='${sizing}' HP_PLAN='${plan}' HP_PUBLIC_HOST='${hp_public_host}' HP_ADMIN_HOST='${hp_admin_host}' bash /opt/hp-app/ops/vps/bootstrap-managed.sh" ]
