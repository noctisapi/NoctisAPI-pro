# NoctisAPI PRO — Staging environment template
# ─────────────────────────────────────────────────────────────────────────────
# Staging is an ISOLATED smoke-test environment. It must never reuse a
# production secret, volume, or domain. It has no Traefik/TLS — app and admin
# are published on 127.0.0.1 only (see compose/docker-compose.staging.yml),
# on different local ports than the dev stack, so it can run side-by-side
# with dev without colliding.
#
# HOW TO USE
#   cp .env.staging.example .env.staging
#   (optionally change the values below — none of them need to be secret)
#   docker compose -f compose/docker-compose.staging.yml --env-file .env.staging up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
APP_ENV=staging
HP_DEPLOYMENT_ID=staging-local

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+pysqlite:////data/honeypot.db

# ── Core secret ───────────────────────────────────────────────────────────────
# Synthetic — staging data is disposable, so this does not need to be kept
# secret or stable. Never copy a production HP_SEED here.
HP_SEED=staging-synthetic-seed-not-for-production

# ── Admin panel ───────────────────────────────────────────────────────────────
# Synthetic — never reuse a production HP_PANEL_TOKEN.
HP_PANEL_TOKEN=staging-synthetic-panel-token

# ── PRO Licensing ─────────────────────────────────────────────────────────────
# No license configured by default: staging runs in CORE mode with PRO
# features disabled. Point LICENSE_KEY / PRO_BACKEND_URL at your own test
# license if you need to validate PRO behavior — never a production license.
# LICENSE_KEY=
# PRO_BACKEND_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
